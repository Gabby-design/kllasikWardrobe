# Admin Security (REQUIRED)
ADMIN_PASSPHRASE=your_custom_admin_passphrase_here
ADMIN_SESSION_SECRET=your_32_character_random_hex_or_secret_here

# Upstash Redis / Vercel KV (Authoritative Database - REQUIRED)
KV_REST_API_URL=https://xxxx.upstash.io
KV_REST_API_TOKEN=your_upstash_rest_token_here
# Alternative standard Upstash env names also supported:
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Vercel Blob (Product Image Storage - REQUIRED on Vercel)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# Store & Contact Details
NEXT_PUBLIC_WHATSAPP_PHONE=2347075039738
OWNER_EMAIL=gabrieltolulope50@gmail.com

# Email Provider (Choose any 1 for order receipts)
# Option 1: Resend (Recommended)
RESEND_API_KEY=re_your_api_key_here
# Option 2: Brevo
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here
# Option 3: Gmail SMTP
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Supabase (Legacy order recording fallback, optional)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
